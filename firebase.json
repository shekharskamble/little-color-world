{
  "hosting": {
    "public": "content/cdn",
    "ignore": ["**/release.json", "**/README.md", "**/.*"],
    "headers": [
      { "source": "/v1/manifest.json*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
      { "source": "/v1/packs/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ]
  }
}
